<!doctype html><html lang="da"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Evolutionær rumtid V2 · Laboratorium</title>
<style>
:root{--ink:#18362e;--muted:#516961;--line:#d3ded3;--paper:#f6f4eb;--panel:#fffdf8}
*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font:16px/1.6 system-ui,sans-serif}
main{width:min(900px,calc(100% - 32px));margin:38px auto}h1,h2{font:normal clamp(2.35rem,6vw,4.4rem)/1.03 Georgia,serif;margin:0}h2{font-size:clamp(1.65rem,4vw,2.4rem)}
p{color:var(--muted)}section{background:var(--panel);border:1px solid var(--line);border-radius:1rem;padding:clamp(14px,4vw,28px);margin:24px 0}
.controls{display:flex;align-items:end;flex-wrap:wrap;gap:.75rem;margin:1rem 0}.controls label{display:grid;gap:.15rem;font-size:.9rem;font-weight:600}
select{font:inherit;color:inherit;background:var(--panel);padding:.45rem;border:1px solid #a9bdaf;border-radius:.55rem}select:focus-visible{outline:3px solid #397883;outline-offset:3px}
svg{width:100%;min-width:360px;display:block}svg text{font:13px system-ui;fill:var(--muted)}#graph{overflow:auto}#legend{display:flex;flex-wrap:wrap;gap:.6rem 1rem;font-size:.9rem}#legend span::before{content:"";width:1rem;height:.19rem;display:inline-block;background:var(--c);margin-right:.35rem;vertical-align:middle}
</style></head><body><main>
<h1>Evolutionær rumtid V2</h1><p>Følg et harmonisk skalarfelt, mål svagfeltsbinding, og se, hvordan en kompakt retning bliver synlig eller usynlig for en rumlig probe.</p>
<section><h2 id="heading"></h2><p id="note"></p>
<div class="controls"><label>Forsøg<select id="experiment">
<option value="binding">Binding · radialt svagt felt</option><option value="free">Spredning · fast Minkowski</option>
<option value="expansion">Ekspansion · homogen Einstein–Klein–Gordon</option><option value="circle">Kompakt retning · Bianchi I</option>
</select></label><label id="variant-label"><span id="variant-name"></span><select id="variant"></select></label></div>
<div id="graph"></div><div id="legend"></div><p id="readout" aria-live="polite"></p></section>
</main><script type="application/json" id="data">__DATA__</script><script>
const $=id=>document.getElementById(id);
const data=JSON.parse($("data").textContent);
const palette=["#176e60","#a05325","#436795","#85568b","#71864b","#835562","#277c87","#746450","#4c5535"];
const fmt=(v,n=3)=>v.toLocaleString("da-DK",{maximumFractionDigits:n});
const config={
 binding:["Binding og kritisk dimension","Blå, grøn og brun følger den fulde radiale Schrödinger–Poisson-tilnærmelse. Den er ikke en relativistisk signalmodel.","3 %, samme norm",["width/.97","width/1.03","amplitude/1"],["Smal start","Bred start","Stationær reference"]],
 free:["Et frit felt spredes","Samme harmoniske potentiale og nominel startradius i alle dimensioner. Geometrien er fast Minkowski.","Observabel",["energy_within_r4","radial_entropy"],["Andel energi i r < 4","Radial Shannon-entropi"]],
 expansion:["Dæmper flere dimensioner oscillationerne?","Sammenlign fast koblet starttæthed med fast H/m. Her er løsningen homogen Einstein–Klein–Gordon.","Normalisering",["density","Hubble"],["Samme dimensionløse tæthed","Samme H/m"]],
 circle:["Én geometri, to målte dimensioner","Cirklen er foreskrevet, mens dens størrelse udvikles sammen med rumtiden. Proben måler spektral dimension på en frossen rumlig skive.","Startforskydning",[-1,0,1],["Cirklen starter med kontraktion","Isotrop lokal ekspansion","Cirklen starter med hurtigere ekspansion"]]
};
function graph(series,xlabel,ylabel){
 const all=series.flatMap(s=>s[1]);
 const minX=Math.min(...all.map(a=>a[0])),maxX=Math.max(...all.map(a=>a[0]));
 const minY=Math.min(...all.map(a=>a[1])),maxY=Math.max(...all.map(a=>a[1]));
 const span=(maxY-minY)||1,lo=minY-.07*span,hi=maxY+.07*span;
 const X=x=>75+(x-minX)/(maxX-minX)*535,Y=y=>250-(y-lo)/(hi-lo)*215;
 let svg='<svg viewBox="0 0 650 303" role="img" aria-label="'+ylabel+'">';
 for(let j=0;j<5;j++){
  const y=lo+(hi-lo)*j/4,x=minX+(maxX-minX)*j/4;
  svg+=`<path d="M75,${Y(y)}H610" stroke="#d3ded3"/><text x="67" y="${Y(y)+4}" text-anchor="end">${fmt(y)}</text><text x="${X(x)}" y="266" text-anchor="middle">${fmt(x)}</text>`;
 }
 svg+=`<text x="4" y="20">${ylabel}</text><text x="340" y="292" text-anchor="middle">${xlabel}</text>`;
 series.forEach(([name,points],i)=>{svg+=`<polyline points="${points.map(([x,y])=>X(x)+","+Y(y)).join(" ")}" fill="none" stroke="${palette[i]}" stroke-width="2.7"/>`;});
 $("graph").innerHTML=svg+"</svg>";
 $("legend").innerHTML=series.map(([name],i)=>`<span style="--c:${palette[i]}">${name}</span>`).join("");
}
function draw(){
 const key=$("experiment").value,v=$("variant").value;
 let entries,x,y,group,ylabel,xlabel="Tid";
 if(key==="binding"){
   const [kind,ratio]=v.split("/");
   entries=data.binding.filter(r=>r.perturbation===kind&&r.ratio===+ratio);
   x="time";y="rms_ratio";group="n";ylabel="Rms-radius / startværdi";
 }else if(key==="free"){
   entries=data.free.filter(r=>r.time>=0);
   x="time";y=v;group="n";ylabel=config.free[4][config.free[3].indexOf(v)];
 }else if(key==="expansion"){
   entries=data.expansion.filter(r=>r.normalization===v&&(r.n==="inf"||+r.n<=16));
   x="proper_time";y="volume_rate";group="n";ylabel="nH/m";xlabel="Egentid × m";
 }else{
   entries=data.circle.filter(r=>r.shear_sign===+v&&r.R0===.3);
   x="t";y="spectral_dimension";group="heat_time";ylabel="Spektral dimension";xlabel="Egentid × m";
 }
 const labels=[...new Set(entries.map(r=>r[group]))];
 const series=labels.map(g=>[(key==="circle"?"u = ":"n = ")+g,entries.filter(r=>r[group]===g).map(r=>[r[x],r[y]])]);
 graph(series,xlabel,ylabel);
 $("readout").textContent="Seneste værdi i hver kurve · "+series.map(([name,a])=>name+": "+fmt(a.at(-1)[1],5)).join(" · ");
}
function change(){
 const c=config[$("experiment").value];
 $("heading").textContent=c[0];$("note").textContent=c[1];$("variant-name").textContent=c[2];
 $("variant").replaceChildren(...c[3].map((v,i)=>new Option(c[4][i],v)));draw();
}
$("experiment").addEventListener("change",change);$("variant").addEventListener("change",draw);change();
</script></body></html>
